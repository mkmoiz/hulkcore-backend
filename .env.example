PORT=4000
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/hulkcore
# Upload limits in bytes (defaults: image 5MB, report 20MB)
MAX_IMAGE_FILE_SIZE_BYTES=5242880
MAX_REPORT_FILE_SIZE_BYTES=20971520
# Alternatively, use granular vars below:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hulkcore
DB_POOL_SIZE=10

# Redis cache (optional)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_PREFIX=hulk:
REDIS_CONNECT_TIMEOUT_MS=5000
PUBLIC_NAV_CACHE_TTL_SEC=300
PUBLIC_ENTITY_CACHE_TTL_SEC=120

# Cloudflare R2 (optional for image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_IMAGE_PREFIX=products
R2_REPORT_PREFIX=lab-reports
R2_ENDPOINT=

# OTP auth
OTP_HASH_SECRET=change-this-otp-secret
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
AUTH_SESSION_TTL_MS=2592000000
USER_AUTH_COOKIE_NAME=hulk_auth_token

# MSG91 SMS (optional; if empty, OTP works in dev mode only)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR_NAME=OTP
MSG91_FLOW_ENDPOINT=https://control.msg91.com/api/v5/flow

# ZeptoMail Email OTP (optional; if empty, OTP works in dev mode only)
ZEPTOMAIL_SEND_MAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Hulk Core
ZEPTOMAIL_API_ENDPOINT=https://api.zeptomail.com/v1.1/email

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket fulfillment (optional)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_AUTO_CREATE_ORDER=false
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PACKAGE_LENGTH_CM=10
SHIPROCKET_PACKAGE_BREADTH_CM=10
SHIPROCKET_PACKAGE_HEIGHT_CM=10
SHIPROCKET_PACKAGE_WEIGHT_KG=0.5

# Cookie + CORS settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Comma-separated allowlist used for credentials-enabled CORS.
# Example: http://localhost:3000,http://localhost:5173
# Production cross-site auth usually needs:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Admin auth
ADMIN_LOGIN_EMAIL=admin@hulkcore.local
ADMIN_LOGIN_PASSWORD=admin123
ADMIN_LOGIN_NAME=Hulk Admin
ADMIN_AUTH_COOKIE_NAME=hulk_admin_session
ADMIN_SESSION_TTL_SEC=604800

# Optional admin token fallback for non-cookie clients
ADMIN_API_TOKEN=
